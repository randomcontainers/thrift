# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS source
RUN apk add --no-cache gpgv
ARG VERSION
ARG SOURCE_SHA256
ADD --checksum=sha256:${SOURCE_SHA256} https://dlcdn.apache.org/thrift/${VERSION}/thrift-${VERSION}.tar.gz /src/
ADD https://downloads.apache.org/thrift/${VERSION}/thrift-${VERSION}.tar.gz.asc /src/
# Jens Geyer's release signing key, fingerprint 8CD8 7F18 6F06 E958 EFCA 963D 76BD 340F C4B7 5865,
# which has no expiry date. A release signed with any other key fails here
# until that key is added to keys/thrift-release.gpg.
COPY keys/thrift-release.gpg /tmp/thrift-release.gpg
WORKDIR /src
RUN set -eu; \
    gpgv --keyring /tmp/thrift-release.gpg "thrift-${VERSION}.tar.gz.asc" "thrift-${VERSION}.tar.gz"; \
    mkdir thrift; \
    tar -xzf "thrift-${VERSION}.tar.gz" -C thrift --strip-components=1

FROM ${BASE_IMAGE} AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
# The base image's shared libraries are recorded before anything is
# installed, so that runtime-deps can leave them out.
RUN find /lib /usr/lib -maxdepth 1 -name '*.so*' | sed 's,.*/,,' | LC_ALL=C sort -u > /tmp/base-sonames; \
    apk add --no-cache \
      bison \
      build-base \
      cmake \
      flex \
      samurai
COPY --link --from=source /src/thrift /src/thrift

ARG VERSION
ARG JOBS
# Only the compiler is built: the language libraries, tests and tutorials are
# off, so nothing needs Boost, OpenSSL or the network. The tarball ships a
# scanner and parser generated by upstream's flex and Bison; they are deleted
# so that the build generates them with the distro's.
RUN --network=none printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    grep -Fq "THRIFT_VERSION \"${VERSION}\"" /src/thrift/compiler/cpp/src/thrift/version.h \
      || { echo "compiler/cpp/src/thrift/version.h is not for ${VERSION}" >&2; exit 1; }; \
    rm -f \
      /src/thrift/compiler/cpp/src/thrift/thriftl.cc \
      /src/thrift/compiler/cpp/src/thrift/thrifty.cc \
      /src/thrift/compiler/cpp/src/thrift/thrifty.hh; \
    set -- \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DBUILD_COMPILER=ON \
      -DBUILD_LIBRARIES=OFF \
      -DBUILD_TESTING=OFF \
      -DBUILD_TUTORIALS=OFF; \
    echo "$*" > /tmp/cmake-options; \
    cmake -S /src/thrift -B /build "$@"; \
    cmake --build /build --target thrift-compiler -j"${JOBS:-$(nproc)}"; \
    for f in thrifty.cc thrifty.hh thriftl.cc; do \
      test -s "/build/compiler/cpp/thrift/$f" || { echo "the build did not generate $f" >&2; exit 1; }; \
    done

ARG BASE_IMAGE
ARG SOURCE_SHA256
COPY runtime-deps.alpine /tmp/runtime-deps.extra
# The install also writes ThriftConfig.cmake for the C++ library, which is not
# built. Every generator that compiler/cpp/CMakeLists.txt enables has to be
# listed by thrift --help. runtime-deps lists the so: names of the libraries
# thrift loads that are not in the base image: libstdc++ and libgcc.
RUN DESTDIR=/out cmake --install /build --strip; \
    rm -rf /out/usr/local/lib; \
    extra="$(find /out/usr/local -mindepth 1 ! -path /out/usr/local/bin ! -path /out/usr/local/bin/thrift)"; \
    test -z "$extra" || { echo "unexpected files in /usr/local: $extra" >&2; exit 1; }; \
    test -x /out/usr/local/bin/thrift || { echo "the install has no /usr/local/bin/thrift" >&2; exit 1; }; \
    printed="$(/out/usr/local/bin/thrift --version)"; \
    test "$printed" = "Thrift version ${VERSION}" || { echo "thrift --version printed: $printed" >&2; exit 1; }; \
    /out/usr/local/bin/thrift --help > /tmp/help.txt 2>&1 || true; \
    sed -n 's/^  \([a-z0-9_]*\) (.*):$/\1/p' /tmp/help.txt | LC_ALL=C sort > /tmp/generators; \
    sed -n 's/^THRIFT_ADD_COMPILER(\([a-z0-9_]*\) .*/\1/p' /src/thrift/compiler/cpp/CMakeLists.txt \
      | LC_ALL=C sort > /tmp/generators.expected; \
    test -s /tmp/generators.expected || { echo "no generators found in compiler/cpp/CMakeLists.txt" >&2; exit 1; }; \
    if ! cmp -s /tmp/generators.expected /tmp/generators; then \
      echo "thrift --help does not list the generators CMakeLists.txt enables:" >&2; \
      diff /tmp/generators.expected /tmp/generators >&2 || true; \
      exit 1; \
    fi; \
    meta=/out/usr/local/share/randomcontainers/thrift; \
    mkdir -p "$meta/licenses"; \
    cp /src/thrift/LICENSE /src/thrift/NOTICE "$meta/licenses/"; \
    for f in LICENSE NOTICE; do \
      test -s "$meta/licenses/$f" || { echo "empty license file $f" >&2; exit 1; }; \
    done; \
    echo "${VERSION}" > "$meta/version"; \
    printf '%s\n' \
      "https://dlcdn.apache.org/thrift/${VERSION}/thrift-${VERSION}.tar.gz" \
      "https://downloads.apache.org/thrift/${VERSION}/thrift-${VERSION}.tar.gz.asc" \
      > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "source-sha256: ${SOURCE_SHA256}"; \
      echo "cmake: $(cat /tmp/cmake-options)"; \
      echo "compiler: $(c++ --version | sed -n 1p)"; \
      echo "bison: $(bison --version | sed -n 1p)"; \
      echo "flex: $(flex --version | sed -n 1p)"; \
      echo "generators: $(tr '\n' ' ' < /tmp/generators)"; \
    } > "$meta/buildinfo"; \
    export LC_ALL=C; \
    find /out/usr/local -type f | while read -r f; do \
      if readelf -h "$f" > /dev/null 2>&1; then \
        readelf -d "$f" | sed -n 's/.*(NEEDED).*\[\(.*\)\]$/\1/p'; \
      fi; \
    done | sort -u | while read -r so; do \
      if grep -qxF "$so" /tmp/base-sonames; then continue; fi; \
      echo "so:$so"; \
    done > /tmp/runtime-deps.elf; \
    grep -qx 'so:libstdc++.so.6' /tmp/runtime-deps.elf || { echo "no libstdc++ in runtime-deps" >&2; exit 1; }; \
    cat /tmp/runtime-deps.elf /tmp/runtime-deps.extra | sort -u > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/thrift/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    xargs apk add --no-cache ca-certificates tini < /tmp/runtime-deps; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "thrift"]
CMD ["--version"]
